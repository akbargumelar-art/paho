DATABASE_URL=file:./data/aspri.db
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# === LIVE SOURCES (VPS only) ===
# Hermes Agent
HERMES_ROOT=/root/.hermes
HERMES_STATE_DB=/root/.hermes/state.db
HERMES_GATEWAY_STATE=/root/.hermes/gateway_state.json
HERMES_PROCESSES=/root/.hermes/processes.json
HERMES_SESSIONS_DIR=/root/.hermes/sessions
HERMES_MEMORIES_DIR=/root/.hermes/memories
HERMES_LOGS_DIR=/root/.hermes/logs

# OpenClaw Agent
OPENCLAW_ROOT=/root/.openclaw
OPENCLAW_APPROVALS=/root/.openclaw/exec-approvals.json
OPENCLAW_CONFIG=/root/.openclaw/openclaw.json
OPENCLAW_CRON_JOBS=/root/.openclaw/cron/jobs.json
OPENCLAW_LOGS_DIR=/root/.openclaw/logs

# Assistant Blueprints
ASSISTANT_ROOT=/root/assistant
