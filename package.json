{
  "name": "personal-assistant-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:prepare": "node -e \"require('fs').mkdirSync('data', { recursive: true })\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:prepare && drizzle-kit migrate",
    "db:seed": "npm run db:prepare && npx tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "npm run db:generate && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-slot": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next": "^15.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
